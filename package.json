{
  "name": "vueplantuml-app",
  "version": "1.0.54",
  "private": true,
  "type": "module",
  "description": "Vue.js PlantUML diagram generator with Smetana layout — works offline via file:// on Android",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "dev:all": "npm run dev:api & npm run dev",
    "prebuild": "node scripts/copy-vendor.mjs && node scripts/copy-c4-lib.mjs && node scripts/copy-archimate-lib.mjs && node scripts/generate-pwa-icons.mjs",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-single-html.mjs",
    "build:minimal": "vue-tsc --noEmit && vite build && node scripts/build-minimal.mjs",
    "build:single": "vue-tsc --noEmit && vite build && node scripts/build-single-only.mjs",
    "build:release": "npm run build:single && node scripts/package-release.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm --prefix server run typecheck",
    "test": "vitest run",
    "test:all": "npm run test && npm --prefix server run test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "metrics:refactor": "node scripts/refactor-metrics.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "postinstall": "node scripts/copy-vendor.mjs && node scripts/copy-c4-lib.mjs && node scripts/copy-archimate-lib.mjs && node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@plantuml/core": "^1.2026.6",
    "@tanstack/vue-virtual": "^3.13.35",
    "dagre": "^0.8.5",
    "mermaid": "^11.16.1",
    "pako": "^3.0.1",
    "vue": "^3.5.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.5",
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
