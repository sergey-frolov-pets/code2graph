# Продакшен-сборка по умолчанию — статический сайт без сервера и БД (GitHub Pages).
# Серверная сборка: задайте VITE_API_BASE_URL до npm run build
# (переменная окружения, .env.production.local или server/.env на VPS).
# Значения: same-origin | https://ваш-хост
VITE_API_BASE_URL=

# Аналитика GoatCounter. Пустая строка — выключена.
# Для своего инстанса: VITE_GOATCOUNTER_URL=https://stats.example.com
# Пусто — берётся адрес проекта по умолчанию (stats.code2graph.ru).
VITE_GOATCOUNTER_URL=https://stats.code2graph.ru
