# Локальная разработка: Vite проксирует /api на сервер (vite.config.ts → :3001).
# Статический превью без сервера: создайте .env.local с VITE_API_BASE_URL=
VITE_API_BASE_URL=same-origin

# Локальная разработка: аналитика выключена, чтобы не засорять статистику.
VITE_GOATCOUNTER_URL=

# Сид для старых конвертов ключей LLM задайте в .env.local (не коммитится).
# Новые ключи шифруются в браузере и остаются после обновления версии.
# VITE_LLM_KEY_SEED=<случайная строка от 16 символов>
