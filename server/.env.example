PORT=3001
DB_PATH=./data/library.db

# Адрес API, который вшивается во фронтенд при сборке на VPS.
# Node-сервер эту переменную не читает — её забирает scripts/deploy/frontend-env.sh.
# same-origin — nginx проксирует /api на этот хост.
# Пустое значение — статическая сборка без сервера (как GitHub Pages).
VITE_API_BASE_URL=same-origin

# Секрет для Bearer-токенов (задайте в продакшене)
AUTH_TOKEN_SECRET=

# Опционально: free LLM proxy
GEMINI_API_KEY=
LLM_RATE_LIMIT_PER_MINUTE=20
