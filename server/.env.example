PORT=3001
DB_PATH=./data/library.db

# Секрет для Bearer-токенов. В продакшене — случайная строка не короче 32 символов.
AUTH_TOKEN_SECRET=

# Публичный адрес сайта для CORS. Пусто — остаются адреса code2graph.ru и localhost.
PUBLIC_ORIGIN=

# Разрешённые origin через запятую. Если задано, заменяет список по умолчанию.
# CORS_ORIGINS=https://diagrams.example.com,http://localhost:5173

# Регистрация новых пользователей. false — только администратор создаёт учётки.
REGISTRATION_ENABLED=true

# Необязательный первый сегмент адреса /{slug}/{user}/{link}.
LIBRARY_PUBLIC_SLUG=

# Каталог со статическим фронтендом. Пусто — только API.
# В Docker задаётся как /app/dist.
# STATIC_DIR=

# Значение apiBaseUrl в GET /deployment.json.
DEPLOYMENT_API_BASE_URL=/api

# Токен MCP agent API. Без него маршруты /api/agent закрыты,
# пока не задан AGENT_API_ALLOW_PUBLIC=true.
# AGENT_API_TOKEN=
# AGENT_API_ALLOW_PUBLIC=false

# Free LLM proxy. Ключи остаются на сервере.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
LLM_RATE_LIMIT_PER_MINUTE=20
