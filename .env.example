# Адрес Library API для сборки фронтенда.
# Код менять не нужно — режим выбирается только этой переменной.
#
# Пусто — статическая сборка без сервера и базы данных (GitHub Pages).
# Библиотека диаграмм хранится в браузере (IndexedDB).
#
# same-origin — API на том же хосте, путь /api (VPS с nginx).
# https://example.com — явный адрес сервера.
VITE_API_BASE_URL=
