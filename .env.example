# Адрес Library API для сборки фронтенда.
# Код менять не нужно — режим выбирается только этой переменной.
#
# Пусто — статическая сборка без сервера и базы данных (GitHub Pages).
# Библиотека диаграмм хранится в браузере (IndexedDB).
#
# same-origin — API на том же хосте, путь /api (VPS с nginx).
# https://example.com — явный адрес сервера.
VITE_API_BASE_URL=

# Адрес инстанса GoatCounter (аналитика без cookie, без персональных данных).
# Не задана — используется адрес проекта по умолчанию (stats.code2graph.ru).
# Пустая строка — аналитика выключена: скрипт не загружается, визиты не уходят.
# Свой инстанс или форк: https://stats.example.com
VITE_GOATCOUNTER_URL=

# Сид для старых конвертов API-ключей LLM (enc:v1), сохранённых прошлыми сборками.
# Случайная строка не короче 16 символов. Не коммитьте настоящий сид:
# положите его в .env или .env.local (они в .gitignore).
# Сборка GitHub Pages читает секрет репозитория VITE_LLM_KEY_SEED.
# Новые ключи шифруются ключом этого браузера и переживают обновление версии
# и смену сида. Сид сборки нужен один раз, чтобы прочитать ещё не перенесённые ключи.
# VITE_LLM_KEY_SEED=
