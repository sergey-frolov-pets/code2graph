# Пример для продакшена (скопируйте в /opt/code2graph/server/.env)

PORT=3001
DB_PATH=/opt/code2graph/data/library.db
AUTH_TOKEN_SECRET=change_me_to_random_long_secret_at_least_32_chars
REGISTRATION_ENABLED=true

# Публичный origin сайта. Попадает в CORS и в deployment.json.
PUBLIC_ORIGIN=https://www.code2graph.ru

# Адрес API, который браузер читает из /deployment.json после статической сборки.
DEPLOYMENT_API_BASE_URL=/api

# Free LLM proxy (ключи только на сервере, не в браузере)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
LLM_RATE_LIMIT_PER_MINUTE=20

# MCP
# AGENT_API_TOKEN=
