# Пример для продакшена (скопируйте в /opt/code2graph/server/.env)

PORT=3001
DB_PATH=/opt/code2graph/data/library.db
AUTH_TOKEN_SECRET=change_me_to_random_long_secret
REGISTRATION_ENABLED=true

# Вшивается во фронтенд при сборке (scripts/deploy/frontend-env.sh).
# same-origin — сайт и /api на одном домене. Пусто — статика без сервера.
# Если строка отсутствует, деплой на VPS подставляет same-origin.
VITE_API_BASE_URL=same-origin

# Free LLM proxy (ключи только на сервере, не в браузере)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
LLM_RATE_LIMIT_PER_MINUTE=20

# lava.top. Email покупателя уходит только в запрос инвойса и в базу не пишется.
# LAVA_API_KEY=
# LAVA_WEBHOOK_KEY=
# LAVA_OFFER_CLOUD_MONTH=
# LAVA_OFFER_CLOUD_YEAR=
# LAVA_OFFER_AI_MONTH=
# LAVA_OFFER_AI_YEAR=
# LAVA_OFFER_TOKENS_100=
# LAVA_OFFER_TOKENS_500=
# LAVA_OFFER_TOKENS_2000=
# LAVA_OFFER_TEAM_5_MONTH=
# LAVA_OFFER_TEAM_5_YEAR=
# LAVA_OFFER_TEAM_15_MONTH=
# LAVA_OFFER_TEAM_15_YEAR=
# LAVA_OFFER_GIFT_CLOUD_MONTH=
# LAVA_OFFER_GIFT_CLOUD_YEAR=
# LAVA_OFFER_GIFT_TOKENS_100=
# LAVA_OFFER_GIFT_TEAM_MONTH=
# LAVA_OFFER_ENTERPRISE=
# BILLING_PUBLIC_BASE_URL=https://www.code2graph.ru
